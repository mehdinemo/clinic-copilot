# LLM Model Configuration
# Provider:model format (e.g., "google_genai:gemini-3.8-flash", "google_genai:gemini-3.5-flash-lite", "openai:gpt-4o-mini")
# Google AI Studio Free Tier verified models:
# - "google_genai:gemini-3.8-flash" (Recommended active Free Tier workhorse)
# - "google_genai:gemini-3.5-flash-lite" (Active Free Tier lightweight model)
# If omitted, auto-detects based on GOOGLE_API_KEY or OPENAI_API_KEY
LLM_MODEL="google_genai:gemini-3.5-flash-lite"

# Provider API Keys (at least one is required for live LLM operations)
OPENAI_API_KEY="your-openai-api-key-here"
GOOGLE_API_KEY="your-google-api-key-here"

# Global Proxy Configuration (Optional - for local HTTP or SOCKS5 proxies)
# HTTP Proxy example:
# HTTPS_PROXY="http://127.0.0.1:8080"
# HTTP_PROXY="http://127.0.0.1:8080"

# SOCKS5 Proxy example:
# SOCKS_PROXY="socks5://127.0.0.1:2080"
# ALL_PROXY="socks5://127.0.0.1:2080"

# Optional database URL (defaults to in-memory SQLite if not specified)
# DATABASE_URL="sqlite:///clinic.db"

